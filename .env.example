# Copy to .env for local overrides. Example values only, never real secrets.

POSTGRES_DB=jobqueue
POSTGRES_USER=jobqueue
POSTGRES_PASSWORD=jobqueue
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

REDIS_HOST=redis
REDIS_PORT=6379

DATABASE_URL=postgresql+asyncpg://jobqueue:jobqueue@postgres:5432/jobqueue
REDIS_URL=redis://redis:6379/0

ENVIRONMENT=local
LOG_LEVEL=INFO
LOG_FORMAT=json

# Distributed-safety timings. JOB_HEARTBEAT_SECONDS must be smaller than
# JOB_LEASE_SECONDS or the service refuses to start.
WORKER_POLL_INTERVAL_SECONDS=1
JOB_LEASE_SECONDS=60
JOB_HEARTBEAT_SECONDS=20
SCHEDULER_INTERVAL_SECONDS=1
SCHEDULER_BATCH_SIZE=100
RECOVERY_INTERVAL_SECONDS=5
RECOVERY_BATCH_SIZE=100
